# Ejemplo de manifest.json para PRODUCCIÓN
# Copia estos valores a frontend/public/manifest.json cuando despliegues

{
  "manifest_version": 3,
  "name": "URL-Scan",
  "version": "1.0.0",
  "description": "Extensión de navegador para escaneo y análisis de URLs.",
  
  "permissions": [
    "activeTab",
    "tabs"
  ],
  
  "host_permissions": [
    "https://tu-api-domain.com/*",
    "http://*",
    "https://*"
  ],
  
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "index.html",
    "default_title": "Analizar URL con URL-Scan"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
