# Example of manifest.json for PRODUCTION
# Copy these values to frontend/public/manifest.json when deploying

{
  "manifest_version": 3,
  "name": "URL-Scan",
  "version": "1.0.0",
  "description": "Browser extension for URL scanning and security analysis.",
  
  "permissions": [
    "activeTab",
    "tabs"
  ],
  
  "host_permissions": [
    "https://tu-api-domain.com/*",
    "http://*",
    "https://*"
  ],
  
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "index.html",
    "default_title": "Analyze URL with URL-Scan"
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
