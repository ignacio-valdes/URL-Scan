{
  "manifest_version": 3,
  "name": "URL-Scan",
  "version": "1.0.0",
  "description": "Extensión de navegador para escaneo y análisis de URLs.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "URL-Scan",
    "default_icon": {
      "16": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  }
}